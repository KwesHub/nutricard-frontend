      "css": ".ds-chip{display:inline-block;padding:4px 12px;border-radius:9999px;font:600 12px 'DM Sans',system-ui,sans-serif}.ds-chip small{font-weight:400}.ds-chip-gold{background:#e8bf4a;color:#2a1d00;box-shadow:0 0 0 2px #fff}"
