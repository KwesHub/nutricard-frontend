    {
      "name": "Gold Food Card",
      "kind": "card",
      "refersTo": "card-gold",
      "description": "The signature unit: rating, photo slot, name, five-stat strip and a dark badge band.",
      "html": "<article class=\"ds-card\"><div class=\"ds-top\"><b class=\"ds-ovr\">79</b><span class=\"ds-tier\">GOLD</span></div><div class=\"ds-photo\">🧄</div><h3 class=\"ds-name\">Garlic</h3><div class=\"ds-stats\"><span>PRO<b>39</b></span><span>MIC<b>51</b></span><span>ENE<b>79</b></span><span>GUT<b>38</b></span><span>PHY<b>92</b></span></div><div class=\"ds-band\">Manganese · Vitamin B6</div></article>",
      "css": ".ds-card{width:240px;overflow:hidden;border-radius:16px;background:linear-gradient(135deg,#f7d676,#e8bf4a,#c9972a);color:#2a1d00;box-shadow:0 10px 15px -3px rgba(0,0,0,.4);font-family:'DM Sans',system-ui,sans-serif;transition:transform .2s}.ds-card:hover{transform:translateY(-4px)}.ds-top{padding:12px 16px 0}.ds-ovr{display:block;font:700 60px/1 'Barlow Condensed',Impact,sans-serif}.ds-tier{font:600 14px 'Barlow Condensed',Impact,sans-serif;letter-spacing:.1em}.ds-photo{margin:8px 16px 0;height:100px;display:flex;align-items:center;justify-content:center;font-size:48px;background:rgba(0,0,0,.1);border-radius:12px}.ds-name{margin:12px 16px 0;font:700 30px/1 'Barlow Condensed',Impact,sans-serif;text-transform:uppercase;letter-spacing:.025em}.ds-stats{display:grid;grid-template-columns:repeat(5,1fr);margin:12px 16px 16px;padding-top:8px;border-top:1px solid rgba(42,29,0,.3);text-align:center;font:600 12px 'Barlow Condensed',Impact,sans-serif;letter-spacing:.1em}.ds-stats b{display:block;font-size:24px;letter-spacing:0}.ds-band{background:#0b1120;color:#fff;padding:12px 16px;font-size:12px}"
    }
